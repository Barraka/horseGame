; Engine configuration file.
; Open this folder in Godot 4.7 (Project Manager > Import) to edit and run the game.

config_version=5

[application]

config/name="Horse Game"
config/description="Ride, care for and collect horses. Riding prototype."
run/main_scene="res://scenes/stable.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameInput="*res://scripts/game_input.gd"
Stable="*res://scripts/stable_data.gd"
RiderData="*res://scripts/rider_data.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
